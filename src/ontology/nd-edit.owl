# Class: obo:ND_0002022 (leukodystrophy)

AnnotationAssertion(obo:IAO_0000114 obo:ND_0002022 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:ND_0002022 "A neurological disease which is realized by some dysmyelinating disease course.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0002022 "Discussion is required to determine the status of the leukodystrophies as asserted types of neurological diseases or whether they are best left as inferred types.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0002022 "The distinguishing features of the leukodystrohies, aka dysmyelinating diseases, that separate them from demyelinating disease are that (1) the pathological processes invloved prevent the normal formation and maintence of myelin and (2) the eitology of the disease is hypothesized to be exclusively genetic. ")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0002022 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0002022 "dysmyelinating disease")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0002022 "http://en.wikipedia.org/wiki/Leukodystrophy")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0002022 "http://ulf.org/what-is-leukodystrophy")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0002022 "http://purl.obolibrary.org/obo/HP_0002415")
AnnotationAssertion(rdfs:label obo:ND_0002022 "leukodystrophy")
SubClassOf(obo:ND_0002022 obo:ND_0000001)
SubClassOf(obo:ND_0002022 ObjectSomeValuesFrom(obo:BFO_0000054 obo:ND_0006016))

