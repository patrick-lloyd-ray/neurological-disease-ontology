AnnotationAssertion(obo:IAO_0000115 obo:ND_0006010 "Acute encephalomyelitis is a transient dymelinating disease course in which the patient has a single brief but intense attack of inflammation in the brain, or spinal cord, or optic nerve that causes damage to the myelin.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0006010 "Mark Jensen")
AnnotationAssertion(rdfs:label obo:ND_0006010 "acute disseminated encephalomyelitis transient disease course")
SubClassOf(obo:ND_0006010 obo:OGMS_0000066)
DisjointClasses(obo:ND_0006010 obo:ND_0006013)

