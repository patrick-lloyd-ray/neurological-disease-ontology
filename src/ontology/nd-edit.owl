# Object Property: obo:ND_0004000 (results in)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0004000 "‘disease’ D 'results in' ‘syndrome’ S =def

(D 'is realized by' ‘disease course’ C)
and (C 'has specific dependent at some time' S) 
and (C 'has participant' ‘organism’ O) 
and (O 'is bearer of' (D and S))")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0004000 "This is a shortcut relation.  More specifically:
('disease d' results in 'syndrome s')
is a shortcut for:
(('disease d' realized in 'disease course c') and ('disease course c' produces 'syndrome s').  

Alternatively, if syndromes are process profiles, then:
('disease d' results in 'syndrome s')
is a shortcut for:
(('disease d' realized in 'disease course c') and ('disease course c' has profile 'syndrome s'))")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0004000 "Alexander Diehl")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0004000 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0004000 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0004000 "results_in")
AnnotationAssertion(rdfs:label obo:ND_0004000 "results in")
SubObjectPropertyOf(obo:ND_0004000 owl:topObjectProperty)
InverseObjectProperties(obo:ND_0004000 obo:ND_0004001)
AsymmetricObjectProperty(obo:ND_0004000)
ObjectPropertyDomain(obo:ND_0004000 obo:OGMS_0000031)
ObjectPropertyRange(obo:ND_0004000 obo:OGMS_0000086)

# Object Property: obo:ND_0004001 (results from)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0004001 "This is a shortcut relation.  More specifically:
('syndrome s' results from 'disease d')
is a shortcut for:
(('syndrome s' produced by 'disease course c') and ('disease course c' realizes 'disease d')).

Alternatively, if syndromes are process profiles, then:
('syndrome s' results from 'disease d')
is a shortcut for:
(('syndrome s' process profile of 'disease course c') and ('disease course c' realizes 'disease d')).")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0004001 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0004001 "results_from")
AnnotationAssertion(rdfs:label obo:ND_0004001 "results from")
AsymmetricObjectProperty(obo:ND_0004001)
ObjectPropertyDomain(obo:ND_0004001 obo:OGMS_0000086)
ObjectPropertyRange(obo:ND_0004001 obo:OGMS_0000031)

