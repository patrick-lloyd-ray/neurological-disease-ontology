AnnotationAssertion(obo:IAO_0000117 obo:ND_0008000 "Alexander D. Diehl")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008000 "Donat Sule")
AnnotationAssertion(rdfs:label obo:ND_0008000 "cerebrovascular disorder")
SubClassOf(obo:ND_0008000 obo:OGMS_0000045)

# Class: obo:ND_0008001 (stroke)

AnnotationAssertion(obo:IAO_0000117 obo:ND_0008001 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008001 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008001 "Naveed Chaudhry")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0008001 "cerebrovascular accident")
AnnotationAssertion(rdfs:label obo:ND_0008001 "stroke")
SubClassOf(obo:ND_0008001 obo:ND_0008000)

# Class: obo:ND_0008002 (ischemic stroke)

AnnotationAssertion(obo:IAO_0000114 obo:ND_0008002 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:ND_0008002 "An ischemic stroke is caused by the lack of blood flow to part of the brain which then initiates the ischemic cascade and results in brain cell damage and infarction.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0008002 "disorder. occurs when an artery to the brain is blocked.  The brain depends on its arteries to bring fresh blood from the heart and lungs. The blood carries oxygen and nutrients to the brain, and takes away carbon dioxide and cellular waste. If an artery is blocked, the brain cells (neurons) cannot make enough energy and will eventually stop working. If the artery remains blocked for more than a few minutes, the brain cells may die. The most common problem is narrowing of the arteries in the neck or head. This is most often caused by atherosclerosis, or gradual cholesterol deposition. If the arteries become too narrow, blood cells may collect and form blood clots. These blood clots can block the artery where they are formed (thrombosis), or can dislodge and become trapped in arteries closer to the brain (embolism). Another cause of  stroke is blood clots in the heart, which can occur as a result of irregular heartbeat (for example, atrial fibrillation), heart attack, or abnormalities of the heart valves. While these are the most common causes of ischemic stroke, there are many other possible causes. Examples include use of street drugs, traumatic injury to the blood vessels of the neck, or disorders of blood clotting. (http://www.strokecenter.org/patients/about-stroke/ischemic-stroke/)
")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008002 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008002 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008002 "Naveed Chaudhry")
AnnotationAssertion(Annotation(obo:IAO_0000116 "The relationship of 'cerebral infarction' to 'ischemic stroke' is unknown.") obo:IAO_0000118 obo:ND_0008002 "cerebral infarction")
AnnotationAssertion(Annotation(obo:IAO_0000116 "The relationship of 'cerebral ischemia' to 'ischemic stroke' is unknown.") obo:IAO_0000118 obo:ND_0008002 "cerebral ischemia")
AnnotationAssertion(rdfs:label obo:ND_0008002 "ischemic stroke")
SubClassOf(obo:ND_0008002 obo:ND_0008001)

# Class: obo:ND_0008003 (hemorrhagic stroke)

AnnotationAssertion(obo:IAO_0000117 obo:ND_0008003 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008003 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008003 "Naveed Chaudhry")
AnnotationAssertion(rdfs:comment obo:ND_0008003 "")
AnnotationAssertion(rdfs:label obo:ND_0008003 "hemorrhagic stroke")
SubClassOf(obo:ND_0008003 obo:ND_0008001)

# Class: obo:ND_0008004 (thrombotic stroke)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0008004 "A thrombotic stroke is an ischemic stroke that occurs when diseased or damaged cerebral arteries become blocked by the formation of a blood clot within the brain.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008004 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008004 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008004 "Naveed Chaudhry")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0008004 "cerebral thrombosis")
AnnotationAssertion(rdfs:comment obo:ND_0008004 "disorder. thrombotic stroke occurs when diseased or damaged cerebral arteries become blocked by the formation of a blood clot within the brain. Clinically referred to as cerebral thrombosis or cerebral infarction, this type of event is responsible for almost 50 percent of all strokes. Cerebral thrombosis can also be divided into an additional two categories that correlate to the location of the blockage within the brain: large-vessel thrombosis and small-vessel thrombosis. Large-vessel thrombosis is the term used when the blockage is in one of the brain’s larger blood-supplying arteries such as the carotid or middle cerebral, while small-vessel thrombosis involves one (or more) of the brain’s smaller, yet deeper, penetrating arteries. This latter type of stroke is also called a lacuner stroke.
")
AnnotationAssertion(rdfs:label obo:ND_0008004 "thrombotic stroke")
SubClassOf(obo:ND_0008004 obo:ND_0008002)

# Class: obo:ND_0008005 (embolic stroke)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0008005 "An embolic stroke is an ischemic stroke that is caused by a embolus that forms somewhere other than the brain.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008005 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008005 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008005 "Naveed Chaudhry")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0008005 "embolic infarction")
AnnotationAssertion(rdfs:comment obo:ND_0008005 "disorder. embolic stroke is also caused by a clot within an artery, but in this case the clot (or emboli) forms somewhere other than in the brain itself. Often from the heart, these emboli will travel in the bloodstream until they become lodged and cannot travel any farther. This naturally restricts the flow of blood to the brain and results in near-immediate physical and neurological deficits.
")
AnnotationAssertion(rdfs:label obo:ND_0008005 "embolic stroke")
SubClassOf(obo:ND_0008005 obo:ND_0008002)

# Class: obo:ND_0008007 (large-vessel thrombosis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0008007 "Large-vessel thrombosis is a thrombotic stroke with physical basis in the larger blood-supplying arteries such as the carotid or middle cerebral artery.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0008007 "look at Ropper/Brown; Pinciples of Neurology. 8th ed pp686 for more info")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008007 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008007 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008007 "Naveed Chaudhry")
AnnotationAssertion(rdfs:label obo:ND_0008007 "large-vessel thrombosis")
SubClassOf(obo:ND_0008007 obo:ND_0008004)

# Class: obo:ND_0008008 (small-vessel thrombosis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0008008 "Small-vessel thrombosis is a thrombotic stroke with physical basis in one (or more) of the brain’s smaller, yet deeper, penetrating arteries such as the circle of willis,cerebellar arteries and basilar artery.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0008008 "look at Ropper/Brown; Pinciples of Neurology. 8th ed pp686 for more info")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008008 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008008 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008008 "Naveed Chaudhry")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0008008 "lacuner stroke")
AnnotationAssertion(rdfs:label obo:ND_0008008 "small-vessel thrombosis")
SubClassOf(obo:ND_0008008 obo:ND_0008004)

