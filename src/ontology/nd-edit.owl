AnnotationAssertion(obo:IAO_0000117 obo:ND_0006017 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0006017 "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Autoimmune_Process")
AnnotationAssertion(rdfs:label obo:ND_0006017 "autoimmune process")
SubClassOf(obo:ND_0006017 obo:OGMS_0000061)

