AnnotationAssertion(obo:IAO_0000116 obo:ND_0008009 "potential definition-A cryptogenic stroke is a stroke with physical basis in the brain that is caused by unknown is the result of unknown,but is clinically recorded as embolism and results in brain cell damage and infaraction.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008009 "Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008009 "Marcus Ng")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0008009 "Naveed Chaudhry")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0008009 "diagnosis of stroke of unknown cause")
AnnotationAssertion(rdfs:label obo:ND_0008009 "diagnosis of cryptogenic stroke")
SubClassOf(obo:ND_0008009 obo:ND_0008034)

