# Class: obo:ND_0000126 (type II spinal muscular atrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000126 "Form of intermediate spinal muscular atrophy of medium severity. Children with type 2 SMA can sit but do not walk.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000126 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000126 "http://neurolex.org/wiki/Category:Type_II_Spinal_Muscular_Atrophy")
