AnnotationAssertion(obo:IAO_0000117 obo:ND_0006004 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0006004 "tau aggregation")
AnnotationAssertion(rdfs:label obo:ND_0006004 "tau protein aggregation")
