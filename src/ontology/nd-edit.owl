# Class: obo:ND_0000158 (dementia caused by syphilis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000158 "Infectious dementia caused by syphilis is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, exceutive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by a syphilis infection.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000158 "a slow progressive, destructive infection of the brain and the spinal cord. Neurosyphilis has 4 different forms; asymptomatic, meningovascular, tabes dorsalis, and general paresis. Tapes dorsalis: symptoms include peripheral neuropathy, pain in the extrematies, incontinence and ataxia- shakey and unsteady movements.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000158 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000158 "http://alzheimers.about.com/od/typesofdementia/a/neurosyphilis.htm")
AnnotationAssertion(rdfs:label obo:ND_0000158 "dementia caused by syphilis")
EquivalentClasses(obo:ND_0000158 ObjectIntersectionOf(obo:ND_0000180 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000)))
SubClassOf(obo:ND_0000158 obo:ND_0000180)

# Class: obo:ND_0000159 (neurodegenerative disease resulting in dementia)

AnnotationAssertion(obo:IAO_0000114 obo:ND_0000159 obo:IAO_0000123)
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000159 "Neurodegenerative dementia is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, executive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by neurodegeneration.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000159 "I believe this class is unecessary, it overlaps with 'disease resulting in dementia'.

-MJ")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000159 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000159 "neurodegenerative dementia")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000159 "TO DO")
AnnotationAssertion(obo:IAO_0000411 obo:ND_0000159 obo:IAO_0000420)
AnnotationAssertion(rdfs:label obo:ND_0000159 "neurodegenerative disease resulting in dementia")
EquivalentClasses(obo:ND_0000159 ObjectIntersectionOf(obo:ND_0000113 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000)))
SubClassOf(obo:ND_0000159 obo:ND_0000006)

# Class: obo:ND_0000160 (frontotemporal dementia with motor neuron disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000160 "ALS with Dementia")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000160 "Frontotemporal dementia with motor neuron disease is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, exceutive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by neurodegeneration as a result of deposition of tau in the frontal and temporal cortices and where abnormal movement [tremor, rigidity, bradykinesia, postural instability] also occurs resulting in a movement disorder caused by neurodegeneration as a result of ________.

*** DOUBLE-CHECK THE MOVEMENT DISORDER, ITS CAUSE, AND ITS SYMPTOMS ***")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000160 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000160 "FTD-MND")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000160 "Nakano, Imaharu. \"frontotemporal dementia with motor neuron disease .\" Neuropathology 1.1 (2000): 68-75. Print.")
AnnotationAssertion(rdfs:comment obo:ND_0000160 "Should be inferred to be a subtype of motor neuron disease.")
AnnotationAssertion(rdfs:label obo:ND_0000160 "frontotemporal dementia with motor neuron disease")
EquivalentClasses(obo:ND_0000160 ObjectIntersectionOf(obo:ND_0000167 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003003) ObjectAllValuesFrom(obo:BFO_0000054 obo:ND_0006026)))
SubClassOf(obo:ND_0000160 obo:ND_0000167)

# Class: obo:ND_0000161 (atypical Alzheimers disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000161 "Atypical Alzheimers disease is a type of Alzheimers disease where episodic memory loss is not present but other cognitive deficits [visual spatial, attention, orientation, executive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by neurodegeneration as a result of deposition of amyloid plaques and neurofibrillary tangles in the medial temporal lobes.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000161 "Alexander P. Cox")
AnnotationAssertion(rdfs:label obo:ND_0000161 "atypical Alzheimers disease")
EquivalentClasses(obo:ND_0000161 ObjectIntersectionOf(obo:ND_0000152 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003005) ObjectAllValuesFrom(obo:BFO_0000054 obo:ND_0006008)))
SubClassOf(obo:ND_0000161 obo:ND_0000152)

# Class: obo:ND_0000162 (frontal variant of Alzheimers disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000162 "Frontal variant of Alzheimers disease is a neurodegenerative disease where _________ occur with at least one other cognitive deficit [visual spatial, attention, orientation, executive function, functional] resulting in dementia caused by atypical Azlheimers disease.

*** REVISE ***")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000162 "Alexander P. Cox")
AnnotationAssertion(rdfs:comment obo:ND_0000162 "Which super class should be referenced in each disease definition?  Should it be the top level disease type (i.e. neurological disease), the immediate parent class (i.e. atypical Alzheimers disease), or an alternate super class (i.e. nerodegenerative disease)?")
AnnotationAssertion(rdfs:label obo:ND_0000162 "frontal variant of Alzheimers disease")
SubClassOf(obo:ND_0000162 obo:ND_0000161)

# Class: obo:ND_0000163 (logopenic aphasia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000163 "Logopenic progressive aphasia (LPA) is a form of primary progressive aphasia characterized by slow speech and impaired syntactic comprehension and naming. It is similar to Wernicke's aphasia and is associated with atrophy to the left posterior temporal cortex and inferior parietal lobule. It is suspected that an atypical form of Alzheimer's disease is the most common cause of logopenic progressive aphasia.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000163 " speech rate was slow, with long word-finding pauses. Grammar and articulation were preserved, although phonological paraphasias could be present. Repetition and comprehension were impaired for sentences but preserved for single words, and naming was moderately affected. Investigation of phonological loop functions showed that patients were severely impaired in digit, letter, and word span tasks. Performance did not improve with pointing, was influenced by word length, and did not show the normal phonological similarity effect. Atrophy or decreased blood flow was consistently found in the posterior portion of the left superior and middle temporal gyri and inferior parietal lobule.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000163 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000163 "http://en.wikipedia.org/wiki/Logopenic_progressive_aphasia")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000163 "http://www.neurology.org/content/71/16/1227")
AnnotationAssertion(rdfs:comment obo:ND_0000163 "Should be inferred to be a subtype of primary progressive aphasia.")
AnnotationAssertion(rdfs:label obo:ND_0000163 "logopenic aphasia")
SubClassOf(obo:ND_0000163 obo:ND_0000161)

# Class: obo:ND_0000164 (primary progressive nonfluent aphasia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000164 "Primary progressive nonfluent aphasia is a neurodegenerative dementia where progressive difficulties with speech production [hesitant or effortful speech, speech apraxia, stutter, anomia, phonemic paraphasia, agrammatism] occur with at least one other cognitive deficit [visual spatial, attention, orientation, exceutive function, functional] resulting in a dementia syndrome caused by atypical Azlheimers disease.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000164 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000164 "PNFA")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000164 "primary progressive non-fluent aphasia")
AnnotationAssertion(rdfs:comment obo:ND_0000164 "In classical PNFA, atrophy of left perisylvian areas is seen. Comprehensive meta-analyses on MRI and FDG-PET studies identified alterations in the whole left frontotemporal network for phonological and syntactical processing as the most consistent finding. Based on these imaging methods, progressive nonfluent aphasia can be regionally dissociated from the other subtypes of frontotemporal lobar degeneration, frontotemporal dementia and semantic dementia.

From: http://en.wikipedia.org/wiki/Progressive_nonfluent_aphasia#Imaging")
AnnotationAssertion(rdfs:comment obo:ND_0000164 "Should be inferred to be a subtype of primary progressive aphasia.")
AnnotationAssertion(rdfs:label obo:ND_0000164 "primary progressive nonfluent aphasia")
SubClassOf(obo:ND_0000164 obo:ND_0000161)

# Class: obo:ND_0000165 (posterior cortical atrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000165 "Posterior cortical atrophy (PCA), also called Benson's syndrome, is most usually considered to be an atypical variant of Alzheimer's disease. The disease causes atrophy of the back (posterior) part of the cerebral cortex, resulting in the progressive disruption of complex visual processing.

Despite being caused by the same disease process, the effects of posterior cortical atrophy and typical Alzheimer’s disease upon the behaviour, thought processes and skills of individuals with each condition are very different. Typical Alzheimer’s disease is most commonly associated with deterioration in memory, language, perception and a host of other skills and abilities. By contrast, individuals with posterior cortical atrophy tend to have well preserved memory and language but instead show a progressive, dramatic and relatively selective decline in vision and/or literacy skills such as spelling, writing and arithmetic.

In rare cases, PCA can also be due to other diseases including dementia with Lewy bodies and Creutzfeldt–Jakob disease.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000165 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000165 "http://en.wikipedia.org/wiki/Posterior_cortical_atrophy")
AnnotationAssertion(rdfs:label obo:ND_0000165 "posterior cortical atrophy")
SubClassOf(obo:ND_0000165 obo:ND_0000161)

# Class: obo:ND_0000166 (genetic frontotemporal dementia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000166 "Genetic frontotemporal dementia is frontotemporal dementia that is caused by one or more genetic defects.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000166 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000166 "genetic FTD")
AnnotationAssertion(rdfs:label obo:ND_0000166 "genetic frontotemporal dementia")
SubClassOf(obo:ND_0000166 obo:ND_0000167)

# Class: obo:ND_0000167 (frontotemporal dementia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000167 "Frontotemporal dementia is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, executive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by neurodegeneration as a result of deposition of tau in the frontal and temporal cortices.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000167 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000167 "FTD")
AnnotationAssertion(rdfs:label obo:ND_0000167 "frontotemporal dementia")
EquivalentClasses(obo:ND_0000167 ObjectIntersectionOf(obo:ND_0000151 ObjectSomeValuesFrom(obo:BFO_0000113 ObjectIntersectionOf(obo:ND_0005502 ObjectSomeValuesFrom(obo:BFO_0000082 obo:FMA_61824))) ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000) ObjectAllValuesFrom(obo:BFO_0000054 obo:ND_0006020)))
SubClassOf(obo:ND_0000167 obo:ND_0000151)

# Class: obo:ND_0000168 (Parkinson dementia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000168 "Parkinsons dementia is a neurological disease where abnormal movement [tremor, rigidity, bradykinesia, postural instability] occurs resulting in a movement disorder caused by neurodegeneration as a result of death of dopaminergic cells in the substantia nigra, which is followed by cognitive deficits [memory, visual spatial, attention, orientation, exceutive function, functional] that represent a decline from previous levels of functioning resulting in dementia years after the diagnosis of Parkinsons disease caused by neurodegeneration as a result of deposition of Lewy bodies in the cerebral cortex and limic structures.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000168 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000168 "PD-D")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000168 "PDD")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000168 "Parkinson disease dementia")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000168 "Parkinson's dementia")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000168 "Parkinson's disease dementia")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000168 "Parkinsons dementia")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000168 "Parkinsons disease dementia")
AnnotationAssertion(rdfs:label obo:ND_0000168 "Parkinson dementia")
EquivalentClasses(obo:ND_0000168 ObjectIntersectionOf(obo:ND_0000139 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000) ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003001) ObjectAllValuesFrom(obo:BFO_0000054 obo:ND_0006039)))
SubClassOf(obo:ND_0000168 obo:ND_0000139)

# Class: obo:ND_0000169 (corticobasal degeneration)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000169 "A rare neurological disease in which several regions of the brain deteriorate. The cortex is severely affected, especially the fronto-parietal regions, located near the center-top of the head. Other, deeper brain regions are also affected, including parts of the basal ganglia, hence the name \"corticobasal\" degeneration. The combined loss of brain tissue in all these areas causes the symptoms and findings seen in people with CBD.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000169 "Corticobasal degeneration is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, exceutive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia associated with other asymmetrical cortical signs [apraxia, cortical sensory, dysphasia, speech apraxia] and where abnormal movement [akinetic rigid syndrome, hyperkinetic movement disorder, alien limb] occurs resulting in a movement disorder caused by neurodegeneration in the anterior frontal lobe, basal ganglia, and premotor area of the cerebral cortex associated with astroglial inclusions due to a tauopathy.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000169 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000169 "CBD")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000169 "CBGD")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000169 "corticobasal ganglionic degeneration")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000169 "http://neurolex.org/wiki/Category:Corticobasal_Degeneration")
AnnotationAssertion(rdfs:comment obo:ND_0000169 "*** TO DO ***
Should corticobasal degeneration be made a subtype of tauopathy???")
AnnotationAssertion(rdfs:label obo:ND_0000169 "corticobasal degeneration")
EquivalentClasses(obo:ND_0000169 ObjectIntersectionOf(obo:ND_0000151 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000) ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003003) ObjectAllValuesFrom(obo:BFO_0000054 obo:ND_0006024)))
SubClassOf(obo:ND_0000169 obo:ND_0000151)

# Class: obo:ND_0000170 (frontotemporal dementia with Parkinsonism linked to chromosome 17)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000170 "Frontotemporal dementia with Parkinsonism linked to chromosome 17 (FTDP-17) is an autosomal dominant neurodegenerative disorder, which has three cardinal features: behavioral and personality changes, cognitive impairment, and motor symptoms. It is caused by mutations in the MAPT gene, which encodes a microtubule-associated protein tau. Over 100 families with 38 different mutations in the MAPT gene have been identified worldwide. The phenotype of FTDP-17 varies not only between families carrying different mutations but also between and within families carrying the same mutations. The pathogenetic mechanisms underlying the disorder are thought to be related to the altered proportion of tau isoforms or to the ability of tau to bind microtubules and to promote microtubule assembly.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000170 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000170 "FTDP-17")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000170 "frontotemporal dementia and Parkinsonism linked to chromosome 17")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000170 "http://en.wikipedia.org/wiki/Frontotemporal_dementia_and_parkinsonism_linked_to_chromosome_17")
AnnotationAssertion(rdfs:comment obo:ND_0000170 "caused by MAPT mutations")
AnnotationAssertion(rdfs:label obo:ND_0000170 "frontotemporal dementia with Parkinsonism linked to chromosome 17")
SubClassOf(obo:ND_0000170 obo:ND_0000166)

# Class: obo:ND_0000171 (FTDU-17 caused by caused by progranulin mutations)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000171 "FTDU-17 caused by caused by progranulin mutations is frontotemporal dementia that is caused by progranulin mutations on chromosome 17.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000171 "Alexander P. Cox")
AnnotationAssertion(rdfs:label obo:ND_0000171 "FTDU-17 caused by caused by progranulin mutations")
SubClassOf(obo:ND_0000171 obo:ND_0000166)

# Class: obo:ND_0000172 (progressive supranuclear palsy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000172 "A degenerative disease of the central nervous system characterized by balance difficulties; OCULAR MOTILITY DISORDERS (supranuclear ophthalmoplegia); DYSARTHRIA; swallowing difficulties; and axial DYSTONIA. Onset is usually in the fifth decade and disease progression occurs over several years. Pathologic findings include neurofibrillary degeneration and neuronal loss in the dorsal MESENCEPHALON; SUBTHALAMIC NUCLEUS; RED NUCLEUS; pallidum; dentate nucleus; and vestibular nuclei.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000172 "Progressive supranuclear palsy is a degenerative tauopathic disease involving the gradual deterioration and death of specific areas of the brain.  The affected brain cells are both neurons and glial cells. The neurons display neurofibrillary tangles, which are clumps of tau protein, a normal part of a brain cell's internal structural skeleton. These tangles are often different from those seen in Alzheimer's disease, but may be structurally similar when they occur in the cerebral cortex.  Their chemical composition is usually different, however, and is similar to that of tangles seen in corticobasal degeneration.  Lewy bodies are seen in some cases, but it is not clear whether this is a variant or an independent co-existing process.

The principal areas of the brain affected are:

    the basal ganglia, particularly the subthalamic nucleus, substantia nigra and globus pallidus;
    the brainstem, particularly the portion of the midbrain where \"supranuclear\" eye movement resides;
    the cerebral cortex, particularly that of the frontal lobes;
    the dentate nucleus of the cerebellum;
    and the spinal cord, particularly the area where some control of the bladder and bowel resides.

The initial symptoms in two-thirds of cases are loss of balance, lunging forward when mobilizing, fast walking, bumping into objects or people, and falls.

Other common early symptoms are changes in personality, general slowing of movement, and visual symptoms.

Later symptoms and signs are dementia (typically including loss of inhibition and ability to organize information), slurring of speech, difficulty swallowing, and difficulty moving the eyes, particularly in the vertical direction. The latter accounts for some of the falls experienced by these patients as they are unable to look up or down.

Some of the other signs are poor eyelid function, contracture of the facial muscles, a backward tilt of the head with stiffening of the neck muscles, sleep disruption, urinary incontinence and constipation.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000172 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000172 "PSP")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000172 "Steele-Richardson-Olszewski syndrome")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000172 "http://en.wikipedia.org/wiki/Progressive_supranuclear_palsy")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000172 "http://neurolex.org/wiki/Category:Progressive_Supranuclear_Palsy")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000172 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12697")
AnnotationAssertion(rdfs:comment obo:ND_0000172 "PSP cases are often split into two subgroups, PSP-Richardson, the classic type, and PSP-Parkinsonism, where a short-term response to levodopa can be obtained.")
AnnotationAssertion(rdfs:label obo:ND_0000172 "progressive supranuclear palsy")
EquivalentClasses(obo:ND_0000172 ObjectIntersectionOf(obo:ND_0000151 ObjectSomeValuesFrom(obo:BFO_0000113 obo:ND_0005502) ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000) ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003003) ObjectAllValuesFrom(obo:BFO_0000054 obo:ND_0006030)))
SubClassOf(obo:ND_0000172 obo:ND_0000151)

# Class: obo:ND_0000173 (vascular neurological disease resulting in dementia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000173 "Vascular dementia is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, executive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by ischemia.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000173 " imprecise term referring to dementia associated with CEREBROVASCULAR DISORDERS, including CEREBRAL INFARCTION (single or multiple), and conditions associated with chronic BRAIN ISCHEMIA. Diffuse, cortical, and subcortical subtypes have been described.
")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000173 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000173 "VD")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000173 "vascular dementia")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000173 "Gerontol Geriatr 1998 Feb;31(1):36-44")
AnnotationAssertion(obo:IAO_0000411 obo:ND_0000173 obo:IAO_0000420)
AnnotationAssertion(rdfs:label obo:ND_0000173 "vascular neurological disease resulting in dementia")
