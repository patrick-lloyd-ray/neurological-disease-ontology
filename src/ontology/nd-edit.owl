# Class: obo:ND_0000001 (neurological disease)

AnnotationAssertion(obo:IAO_0000111 obo:ND_0000001 "neurological disease")
AnnotationAssertion(obo:IAO_0000114 obo:ND_0000001 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000001 "A disease which has material basis in a neurological disorder and, when realized, the resultant pathological processes affect functioning of the nervous system.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000001 "MJ: Neurological diseases affect the functioning of the nervous system and are caused by structural, biochemical, or electrical abnormalities in the brain, spinal cord, peripheral nerves, plexus or glia.

There are varying etiologies and material bases for neurological diseases, resulting in various patholgies, all somewhat loosely associated by \"affecting\" the nervous system.

As the root node in the ontology (disease branch), this may be best regarded as a primitive. Currently, it is an anatomical location-based definition, which is not maintained in subtypes (functional specializations).")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000001 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000001 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000001 "nervous system disease")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000001 "http://www.nlm.nih.gov/medlineplus/neurologicdiseases.html")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000001 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12681")
AnnotationAssertion(rdfs:label obo:ND_0000001 "neurological disease")
SubClassOf(obo:ND_0000001 obo:OGMS_0000031)
SubClassOf(obo:ND_0000001 ObjectSomeValuesFrom(obo:BFO_0000052 obo:OGMS_0000087))
SubClassOf(obo:ND_0000001 ObjectSomeValuesFrom(obo:BFO_0000113 obo:ND_0005501))

# Class: obo:ND_0000002 (central nervous system disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000002 "Central nervous system disease is a neurological disease that affects the central nervous system.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000002 "Diseases of any component of the brain (including the cerebral hemispheres, diencephalon, brain stem, and cerebellum) or the spinal cord.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000002 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000002 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000232 obo:ND_0000002 "This is a defined class that is included for the purpose of capturing a representation of all diseases that affect the central nervous system.")
AnnotationAssertion(obo:IAO_0000411 obo:ND_0000002 obo:IAO_0000420)
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000002 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi?field=uid&term=D002493")
AnnotationAssertion(rdfs:comment obo:ND_0000002 "A neurological disease realized by processes which are manifested in the central nervous system of an organism OR for whichthe disorder is located in/part of CNS.

One problem: does this mean ALL processes, how is relavence decided?")
AnnotationAssertion(rdfs:label obo:ND_0000002 "central nervous system disease")
EquivalentClasses(obo:ND_0000002 ObjectIntersectionOf(obo:ND_0000001 ObjectSomeValuesFrom(obo:BFO_0000113 ObjectIntersectionOf(obo:ND_0005501 ObjectSomeValuesFrom(obo:BFO_0000171 obo:ND_0002023)))))
SubClassOf(obo:ND_0000002 obo:ND_0000001)

# Class: obo:ND_0000003 (peripheral nervous system disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000003 "A peripheral nervous system disease is a neurological disease that affects the peripheral nervous system.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000003 "Diseases of the peripheral nerves external to the brain and spinal cord, which includes diseases of the nerve roots, ganglia, plexi, autonomic nerves, sensory nerves, and motor nerves.
Donat Sule")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000003 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000232 obo:ND_0000003 "This is a defined class that is included for the purpose of capturing a representation of all diseases that affect the peripheral nervous system.")
AnnotationAssertion(obo:IAO_0000411 obo:ND_0000003 obo:IAO_0000420)
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000003 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi")
AnnotationAssertion(rdfs:label obo:ND_0000003 "peripheral nervous system disease")
SubClassOf(obo:ND_0000003 obo:ND_0000001)

# Class: obo:ND_0000004 (typical Alzheimers disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000004 "Alzheimers disease is a neurological disease where episodic memory loss occurs with at least one other cognitive deficit [visual spatial, attention, orientation, executive function, functional] that represent a decline from previous levels of functioning resulting in dementia caused by neurodegeneration as a result of deposition of amyloid plaques and neurofibrillary tangles in the medial temporal lobes.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000004 "Alexander P. Cox")
AnnotationAssertion(rdfs:label obo:ND_0000004 "typical Alzheimers disease")
EquivalentClasses(obo:ND_0000004 ObjectIntersectionOf(obo:ND_0000152 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003002) ObjectAllValuesFrom(obo:BFO_0000054 obo:ND_0006007)))
SubClassOf(obo:ND_0000004 obo:ND_0000152)

# Class: obo:ND_0000006 (disease resulting in dementia)

AnnotationAssertion(obo:IAO_0000114 obo:ND_0000006 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000006 "An acquired organic mental disorder with loss of intellectual abilities of sufficient severity to interfere with social or occupational functioning. The dysfunction is multifaceted and involves memory, behavior, personality, judgment, attention, spatial relations, language, abstract thought, and other executive functions. The intellectual decline is usually progressive, and initially spares the level of consciousness.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000006 "Dementia is a neurological disease where at least two cognitive deficits [memory, visual spatial, attention, orientation, executive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000006 "a descriptive term for a collection of symptoms that can be caused by a number of disorders that affect the brain. People with dementia have significantly impaired intellectual functioning that interferes with normal activities and relationships. They also lose their ability to solve problems and maintain emotional control, and they may experience personality changes and behavioral problems, such as agitation, delusions, and hallucinations. While memory loss is a common symptom of dementia, memory loss by itself does not mean that a person has dementia.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000006 "Neither of these defintion are correct. This is a simple \"syntactic\" class, and as such needs only a straightforward defintion. The explanatory exposition belongs with the description of the syndrome. 

Eg- A neurological disease which results in [produces] dementia syndrome.

-MJ")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000006 "This is a defined class that is included for the purpose of representing all diseases that result in dementia (the syndrome).")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000006 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000006 "dementia disease")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000006 "http://www.ninds.nih.gov/disorders/dementias/dementia.htm ")
AnnotationAssertion(obo:IAO_0000232 obo:ND_0000006 "Should the logical definition for this class be simply:
disease and ('results in' some dementia)
instead?

Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000411 obo:ND_0000006 obo:IAO_0000420)
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000006 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi?field=uid&term=D003704")
AnnotationAssertion(rdfs:comment obo:ND_0000006 "Check Kinga's slides for all 6 domains of cognitive function!

*** UPDATE ***

There were 8 domains listed in the slides: 

Memory
Language
Perceptual skills
Attention
Constructive abilities
Orientation
Problem solving
Functional abilities

*** CHANGE COGNITIVE DEFICITS IN ALL INSTANCES OF DEMENTIA TO WHATEVER LIST IS USED IN THIS DEFINITION ***
Update: I think that all affected definitions have been changed, but this should be rechecked. (Alex Cox)")
AnnotationAssertion(rdfs:label obo:ND_0000006 "disease resulting in dementia")
EquivalentClasses(obo:ND_0000006 ObjectIntersectionOf(obo:ND_0000001 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000)))
SubClassOf(obo:ND_0000006 obo:ND_0000001)

# Class: obo:ND_0000007 (autonomic nervous system disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000007 "An autonomic nervous system disease is a neurological disease that affects the autonomic nervous system.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000007 "Diseases of the parasympathetic or sympathetic divisions of the AUTONOMIC NERVOUS SYSTEM; which has components located in the CENTRAL NERVOUS SYSTEM and PERIPHERAL NERVOUS SYSTEM. Autonomic dysfunction may be associated with HYPOTHALAMIC DISEASES; BRAIN STEM disorders; SPINAL CORD DISEASES; and PERIPHERAL NERVOUS SYSTEM DISEASES. Manifestations include impairments of vegetative functions including the maintenance of BLOOD PRESSURE; HEART RATE; pupil function; SWEATING; REPRODUCTIVE AND URINARY PHYSIOLOGY; and DIGESTION.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000007 "Alexander P. Cox")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000007 "birnlex_12579")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000007 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12579")
AnnotationAssertion(rdfs:label obo:ND_0000007 "autonomic nervous system disease")
SubClassOf(obo:ND_0000007 obo:ND_0000001)

# Class: obo:ND_0000008 (enteric nervous system disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000008 "A disease of the enteric nervous system (which directly controls the gastrointestinal system).

")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000008 "Alexander P. Cox")
AnnotationAssertion(rdfs:comment obo:ND_0000008 "This term is not included in the NIF-Dysfunction ontology, but is a plausible sister class of both 'sympathetic nervous system disease' and 'parasympathetic nervous system disease'.")
AnnotationAssertion(rdfs:label obo:ND_0000008 "enteric nervous system disease")
SubClassOf(obo:ND_0000008 obo:ND_0000007)

# Class: obo:ND_0000009 (infectious disease resulting in dementia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000009 "Infectious dementia is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, executive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by an infectious agent.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000009 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000009 "infectious dementia")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000009 "http://neurology.osu.edu/cognitive/dementia.html")
AnnotationAssertion(obo:IAO_0000411 obo:ND_0000009 obo:IAO_0000420)
AnnotationAssertion(rdfs:comment obo:ND_0000009 "A number of infectious agents can cause dementia in the elderly: fungi, parasites and viruses. Dementia can also occur with illnesses such as AIDS and Lyme disease.")
AnnotationAssertion(rdfs:label obo:ND_0000009 "infectious disease resulting in dementia")
EquivalentClasses(obo:ND_0000009 ObjectIntersectionOf(obo:ND_0000180 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000)))
SubClassOf(obo:ND_0000009 obo:ND_0000006)

# Class: obo:ND_0000010 (HIV related dementia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000010 "AIDS is primarily an immune system disorder caused by the human immunodeficiency virus (HIV), but it can also affect the nervous system. HIV does not appear to directly invade nerve cells but it jeopardizes their health and function, causing symptoms such as confusion, forgetfulness, behavioral changes, severe headaches, progressive weakness, loss of sensation in the arms and legs, stroke, cognitive motor impairment, or damage to the peripheral nerves. Other complications that can occur as a result of HIV infection or the drugs used to treat it include pain, seizures, shingles, spinal cord problems, lack of coordination, difficult or painful swallowing, anxiety disorder, depression, fever, vision loss, gait disorders, destruction of brain tissue, and coma. Other AIDS-related nervous system disorders may be caused by certain cancers or by illnesses that would not otherwise affect people with healthy immune systems. Among the most common neurological complications are: AIDS dementia complex, causing symptoms such as encephalitis (inflammation of the brain), behavioral changes, and a gradual decline in cognitive function; central nervous system lymphomas, cancerous tumors that either begin in the brain or result from a cancer that has spread from another site in the body; cryptococcal meningitis; cytomegalovirus infections; herpes virus infections; neuropathy; neurosyphilis; progressive multifocal leukoencephalopathy (PML); and psychological and neuropsychiatric disorders.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000010 "HIV related dementia is a neurological disease where cognitive deficits [memory, visual spatial, attention, orientation, exceutive function, functional] occur that represent a decline from previous levels of functioning resulting in dementia caused by an HIV infection.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000010 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000010 "HIV-related dementia")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000010 "http://neurolex.org/wiki/Category:Neurological_Complications_of_AIDS")
AnnotationAssertion(rdfs:comment obo:ND_0000010 "change label to 'HIV related dementia'")
AnnotationAssertion(rdfs:label obo:ND_0000010 "HIV related dementia")
EquivalentClasses(obo:ND_0000010 ObjectIntersectionOf(obo:ND_0000180 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000)))
SubClassOf(obo:ND_0000010 obo:ND_0000180)

# Class: obo:ND_0000011 (dementia associated with Huntingtons disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000011 "Dementia associated with Huntingtons disease is Huntingtons disease that results in dementia.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000011 "Huntington disease (HD) is a devastating disorder that destroys nerve cells (neurons) in parts of the brain. It also lowers levels of chemicals called neurotransmitters that carry signals in the brain. Loss of these cells and neurotransmitters causes uncontrolled movements, loss of mental abilities, and changes in personality, emotional state, or behavior. Mental, emotional, or behavioral decline severe enough to interfere with the ability to carry out everyday activities is known as dementia. ")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000011 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000011 "http://www.emedicinehealth.com/huntington_disease_dementia/article_em.htm")
AnnotationAssertion(rdfs:comment obo:ND_0000011 "*** DOUBLE-CHECK THIS LABEL ***")
AnnotationAssertion(rdfs:label obo:ND_0000011 "dementia associated with Huntingtons disease")
EquivalentClasses(obo:ND_0000011 ObjectIntersectionOf(obo:ND_0000114 ObjectSomeValuesFrom(obo:ND_0004000 obo:ND_0003000)))
SubClassOf(obo:ND_0000011 obo:ND_0000114)

# Class: obo:ND_0000012 (sympathetic nervous system disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000012 "A disease of the sympathetic nervous system (which is responsible for accelerating the heart rate, constricting blood vessels and raising blood pressure).

Symptoms of SNS Disorders

    Blood pressure problems like high blood pressure
    Erectile dysfunction in men
    Heart diseases
    Trouble with breathing and swallowing
    Headache
    Memory loss
    Tremors, seizures
    Loss of muscle strength
    Slurred speech

Causes of SNS Disorders

Nervous system disorder is also known as 'dysautonomia'. If you know the anatomy of the central nervous system, then you will be able to understand the causes of sympathetic nervous system disorders easily.

    Diseases: Many diseases lead to gradual degeneration of nerves, affecting their transmission system. Diabetes and Parkinson's disease can cause SNS disorders.
    Autoimmune Disorders: Autoimmune disorders, wherein immune system considers an organ as a foreign body and attacks it, can lead to SNS disorders.
    Excessive Alcohol Intake: Alcohol abuse is one of the main reasons of SNS disorders.
    Brain Injury: Any type of traumatic brain injury can result in SNS dysfunction.
    Brain Infection: When an infection affects brain and spinal cord directly, it can result in SNS disorders.
    Structural Defects: Structural defects, birth defects can cause SNS disorders.
    Immune System Problems: Severe immune system problems can cause SNS disorders.
    Brain Tumors: Brain tumors, benign or malignant, can result in SNS disorders.
    Interrupted Blood Supply to Brain: A stroke, wherein an interrupted blood supply to brain is noticed, can lead   to SNS dysfunction.

Sympathetic nervous system dysfunction can lead to a condition called 'fibromyalgia'. Patients of fibromyalgia experience pain in muscles and surrounding structures without any obvious tissue damage. Percentage of women (between the ages of 35 and 60 years) or children suffering from fibromyalgia is quite high. SNS dysfunction can result in Reflex Sympathetic Dystrophy Syndrome or Complex Regional Pain Syndrome (CRPS) which is described as a chronic, painful condition. The person suffers from moderate to severe pain that is disproportionate to the event (sprain of fracture) which can induce the pain. Often, an arm or a leg is affected by CRPS. A damaged nerve that controls blood vessels and sweat glands can lead to disrupted blood flow, loss of sensation and abnormal skin temperature at the affected area. The person may complain about intense or burning pain at the site and the condition may worsen over time. This can restrict the movement of the limb and the person may suffer from anxiety and depression. Early detection of the problem helps lower the symptoms. Doctors usually recommend physical therapy and occupational therapy. Pain killers, steroids, medicines to maintain the blood pressure and/or bone loss medications are prescribed by doctors.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000012 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000012 "http://www.buzzle.com/articles/sympathetic-nervous-system-disorders.html")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000012 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12589")
AnnotationAssertion(rdfs:comment obo:ND_0000012 "There was neither a definition for 'sympathetic nervous system disease' provided by the NIF-Dysfunction ontology nor available on wikipedia.  For this reason, a basic Aristotelian definition has been provided for this term.")
AnnotationAssertion(rdfs:label obo:ND_0000012 "sympathetic nervous system disease")
SubClassOf(obo:ND_0000012 obo:ND_0000007)

# Class: obo:ND_0000013 (parasympathetic nervous system disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000013 "A disease of the parasympathetic nervous system (which is part of the nervous system which serves the purpose to slow down the heart rate, increase the activity of the intestine and gland, and to relax down the sphincter muscles).

Any problems occurring in the parasympathetic nervous system are termed as parasympathetic nervous system disorders. There are certain symptoms that you should look out for to ensure that your parasympathetic nervous system and sympathetic nervous system, both are working fine.  For main a major symptom of parasympathetic nervous system disorder is problems with erectile dysfunctions. Men might find it a problem to either initiate an erection or maintain it. Other common symptoms of parasympathetic nervous system disorder include feeling dizzy and light – headed when one stands up. This happens when a person’s blood pressure decreases excessively. Other symptoms of parasympathetic nervous system disorder include the dryness of the mouth and eyes. One might not feel the heat and stop sweating at all. In other cases, if you are suffering from parasympathetic nervous system disorders you might feel like vomiting after having a meal.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000013 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000013 "http://medical-wiki.com/articles/parasympathetic-nervous-system-disorders/")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000013 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12580")
AnnotationAssertion(rdfs:comment obo:ND_0000013 "There was neither a definition for 'parasympathetic nervous system disease' provided by the NIF-Dysfunction ontology nor available on wikipedia.  For this reason, a basic Aristotelian definition has been provided for this term.")
AnnotationAssertion(rdfs:label obo:ND_0000013 "parasympathetic nervous system disease")
SubClassOf(obo:ND_0000013 obo:ND_0000007)

# Class: obo:ND_0000014 (Horner syndrome)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000014 "Horner's syndrome (also Horner syndrome, Bernard-Horner syndrome, Claude Bernard-Horner syndrome or as oculosympathetic palsy) is the combination of drooping of the eyelid (ptosis) and constriction of the pupil (miosis), sometimes accompanied by decreased sweating of the face on the same side; redness of the conjunctiva of the eye is often also present. It indicates a problem with the sympathetic nervous system, a part of the autonomic nervous system. Medical imaging and response to particular eye drops may be required to identify the location of the problem and the underlying cause.

Signs that are found in all patients on the affected side of the face include partial ptosis (drooping of the upper eyelid from loss of sympathetic innervation to the superior tarsal muscle, also known as Müller's muscle[1]); upside-down ptosis (slight elevation of the lower lid); anhidrosis (decreased sweating on the affected side of the face); miosis (small pupils); enophthalmos (the impression that the eye is sunk in); loss of ciliospinal reflex; and bloodshot conjunctiva, depending on the site of lesion. Sometimes there is flushing on the affected side of the face due to dilation of blood vessels under the skin. The pupil's light reflex is maintained as this is controlled via the parasympathetic nervous system.

Horner syndrome is acquired as a result of disease but may also be congenital (inborn) or iatrogenic (caused by medical treatment). Although most causes are relatively benign, Horner syndrome may reflect serious disease in the neck or chest (such as a Pancoast tumor (tumor in the apex of the lung) or thyrocervical venous dilatation).")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000014 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000014 "http://en.wikipedia.org/wiki/Horner_syndrome")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000014 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12586")
AnnotationAssertion(rdfs:comment obo:ND_0000014 "horner syndrome does not appear to qualify as a disease")
AnnotationAssertion(rdfs:label obo:ND_0000014 "Horner syndrome")
SubClassOf(obo:ND_0000014 obo:ND_0000007)

# Class: obo:ND_0000015 (Adie syndrome)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000015 "Adie syndrome, sometimes known as Holmes-Adie's syndrome or Adie's Tonic Pupil, is a neurological disorder characterized by a tonically dilated pupil. It is named after the British neurologist William John Adie. It is caused by damage to the postganglionic fibers of the parasympathetic innervation of the eye, usually by a viral or bacterial infection which causes inflammation, and affects the pupil of the eye and the autonomic nervous system.

Adie syndrome presents with three hallmark symptoms, namely at least one abnormally dilated pupil (mydriasis) which does not constrict in response to light, loss of deep tendon reflexes and diaphoresis (excessive sweating). Other signs may include hyperopia due to accommodative paresis, photophobia and difficulty reading.

Holmes-Adie syndrome is thought to be the result of a viral or bacterial infection that causes inflammation and damage to neurons in the ciliary ganglion, an area of the brain that controls eye movements, and the spinal ganglion, an area of the brain involved in the response of the autonomic nervous system.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000015 "a neurological disorder affecting the pupil of the eye and the autonomic nervous system.  It is characterized by one eye with a pupil that is larger than normal and constricts slowly in bright light  (tonic pupil), along with the absence of deep tendon reflexes, usually in the Achilles tendon.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000015 "syndrome, disorder, or disease?")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000015 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000015 "Adie's pupil")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000015 "Adie's syndrome")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000015 "HAS")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000015 "Holmes-Adie syndrome")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000015 "http://en.wikipedia.org/wiki/Holmes-Adie_syndrome")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000015 "http://www.ninds.nih.gov/disorders/holmes_adie/holmes_adie.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000015 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12581")
AnnotationAssertion(rdfs:label obo:ND_0000015 "Adie syndrome")
SubClassOf(obo:ND_0000015 obo:ND_0000007)

# Class: obo:ND_0000016 (Frey syndrome)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000016 "Frey's syndrome (also known as Baillarger’s syndrome, Dupuy’s syndrome, Auriculotemporal syndrome or Frey-Baillarger syndrome) is a food related syndrome which can be congenital or acquired specially after parotid surgery and can persist for life.

The symptoms of Frey's syndrome are redness and sweating on the cheek area adjacent to the ear. They can appear when the affected person eats, sees, dreams, thinks about or talks about certain kinds of food which produce strong salivation. Observing sweating in the region after eating a lemon wedge may be diagnostic.

Frey's syndrome often results as a side effect of parotid gland surgery. The Auriculotemporal branch of the Trigeminal nerve carries sympathetic fibers to the sweat glands of the scalp and parasympathetic fibers to the parotid gland. As a result of severance and inappropriate regeneration, the fibers may switch courses, resulting in \"Gustatory Sweating\" or sweating in the anticipation of eating, instead of the normal salivatory response. It is often seen with patients who have undergone endoscopic thoracic sympathectomy, a surgical procedure wherein part of the sympathetic trunk is cut or clamped to treat sweating of the hands or blushing. The subsequent regeneration or nerve sprouting leads to abnormal sweating and salivating. It can also include discharge from the nose when smelling certain food.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000016 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000016 "http://en.wikipedia.org/wiki/Frey%27s_syndrome")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000016 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12587")
AnnotationAssertion(rdfs:comment obo:ND_0000016 "syndrome, disorder, or disease?")
AnnotationAssertion(rdfs:label obo:ND_0000016 "Frey syndrome")
SubClassOf(obo:ND_0000016 obo:ND_0000007)

# Class: obo:ND_0000017 (familial dysautonomia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000017 "Familial dysautonomia (FD, sometimes called Riley–Day syndrome[1]) is a disorder of the autonomic nervous system which affects the development and survival of sensory, sympathetic and some parasympathetic neurons in the autonomic and sensory nervous system resulting in variable symptoms including: insensitivity to pain, inability to produce tears, poor growth, and labile blood pressure (episodic hypertension and postural hypotension). People with FD have frequent vomiting crises, pneumonia, problems with speech and movement, difficulty swallowing, inappropriate perception of heat, pain, and taste, as well as unstable blood pressure and gastrointestinal dysmotility. FD does not affect intelligence. Originally reported by Conrad Milton Riley and Richard Lawrence Day in 1949,[2] FD is one example of a group of disorders known as hereditary sensory and autonomic neuropathies HSAN.[3] All HSAN are characterized by widespread sensory dysfunction and variable autonomic dysfunction caused by incomplete development of sensory and autonomic neurons. The disorders are believed to be genetically distinct from each other. FD is seen almost exclusively in Ashkenazi Jews and is inherited in an autosomal recessive fashion.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000017 "a disorder of autonomic nervous system (ANS) function. Most physicians view dysautonomia in terms of failure of the sympathetic or parasympathetic components of the ANS, but dysautonomia involving excessive ANS activities also can occur. Dysautonomia can be local, as in reflex sympathetic dystrophy, or generalized, as in pure autonomic failure. It can be acute and reversible, as in Guillain-Barre syndrome, or chronic and progressive. Several common conditions such as diabetes and alcoholism can include dysautonomia. Dysautonomia also can occur as a primary condition or in association with degenerative neurological diseases such as Parkinson's disease.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000017 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000017 "http://en.wikipedia.org/wiki/Familial_dysautonomia")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000017 "http://www.ninds.nih.gov/disorders/dysautonomia/dysautonomia.htm
")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000017 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12561")
AnnotationAssertion(rdfs:comment obo:ND_0000017 "There is conflict between labeling familial dysautonomia as a disease or as a disorder.")
AnnotationAssertion(rdfs:label obo:ND_0000017 "familial dysautonomia")
SubClassOf(obo:ND_0000017 obo:ND_0000007)

# Class: obo:ND_0000018 (reflex sympathetic dystrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000018 "Type I complex regional pain syndrome.  It does not have demonstrable nerve lesions.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000018 "Alexander P. Cox")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000018 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12585")
AnnotationAssertion(rdfs:label obo:ND_0000018 "reflex sympathetic dystrophy")
SubClassOf(obo:ND_0000018 obo:ND_0000020)

# Class: obo:ND_0000019 (causalgia)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000019 "Type II complex regional pain syndrome.  It does have evidence of obvious nerve damage.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000019 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000019 "http://www.ninds.nih.gov/disorders/reflex_sympathetic_dystrophy/reflex_sympathetic_dystrophy.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000019 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12584")
AnnotationAssertion(rdfs:comment obo:ND_0000019 "consider merging with Synonym(s):   Reflex Sympathetic Dystrophy Syndrome, Causalgia (source http://www.ninds.nih.gov/disorders/reflex_sympathetic_dystrophy/reflex_sympathetic_dystrophy.htm)
")
AnnotationAssertion(rdfs:label obo:ND_0000019 "causalgia")
SubClassOf(obo:ND_0000019 obo:ND_0000020)

# Class: obo:ND_0000020 (complex regional pain syndrome)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000020 "Complex regional pain syndrome (CRPS) is a chronic progressive disease characterized by severe pain, swelling and changes in the skin. Though treatment is often unsatisfactory, early multimodal therapy can cause dramatic improvement or remission of the syndrome in some patients.[1] The International Association for the Study of Pain has proposed dividing CRPS into two types based on the presence of nerve lesion following the injury.

    Type I, formerly known as reflex sympathetic dystrophy (RSD), Sudeck's atrophy, reflex neurovascular dystrophy         (RND) or algoneurodystrophy, does not have demonstrable nerve lesions.
    Type II, formerly known as causalgia, has evidence of obvious nerve damage.

The cause of this syndrome is currently unknown. Precipitating factors include injury and surgery, although there are documented cases that have no demonstrable injury to the original site.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000020 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000020 "http://en.wikipedia.org/wiki/Complex_regional_pain_syndrome")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000020 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12583")
AnnotationAssertion(rdfs:comment obo:ND_0000020 "How should we reconcile the discrepancy between terms that are commonly referred to as a 'syndrome', but fit our criteria for being a disease?  We can include the additional terminology as synonyms, but which term gets to be used as the label?  I assume it should be the ontologically preferable label.")
AnnotationAssertion(rdfs:label obo:ND_0000020 "complex regional pain syndrome")
SubClassOf(obo:ND_0000020 obo:ND_0000007)

# Class: obo:ND_0000021 (autonomic dysreflexia)

AnnotationAssertion(obo:IAO_0000117 obo:ND_0000021 "Alexander P. Cox")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000021 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12582")
AnnotationAssertion(rdfs:comment obo:ND_0000021 "autonomic dysreflexia is characterized in NIF-Dysfunction as a syndrome

autonomic dysreflexia does not appear to fit the criteria for being a disease

autonomic dysreflexia is thought to result when nerve signals in the spinal cord are blocked due to lesions (such as those that can occur in MS patients) or other spinal cord damage")
AnnotationAssertion(rdfs:label obo:ND_0000021 "autonomic dysreflexia")
SubClassOf(obo:ND_0000021 obo:ND_0000007)

# Class: obo:ND_0000022 (multiple system atrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000022 "Multiple system atrophy (MSA) is a rare condition that causes symptoms similar to Parkinson's disease. However, patients with MSA have more widespread damage to the part of the nervous system that controls important functions such as heart rate, blood pressure, and sweating.

The cause is unknown. MSA develops gradually and is most often diagnosed in men older than 60.

Synonyms for multiple system atrophy include: Shy-Drager syndrome Neurologic orthostatic hypotension; Shy-McGee-Drager syndrome; Parkinson's plus syndrome; MSA-P; and MSA-C")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000022 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000022 "Shy-Drager syndrome")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000022 "http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001764/")
AnnotationAssertion(obo:IAO_0000232 obo:ND_0000022 "NIF-Dysfunction lists multiple system atrophy as 'Shy-Drager syndrome'.

*** THIS TERM IS A DUPLICATE OF TERM ND_0000129 ***")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000022 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12576")
AnnotationAssertion(rdfs:label obo:ND_0000022 "multiple system atrophy")
SubClassOf(obo:ND_0000022 obo:ND_0000007)

# Class: obo:ND_0000023 (Charcot-Marie tooth disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000023 "Charcot–Marie–Tooth disease (CMT), known also as Morbus Charcot-Marie-Tooth, Charcot-Marie-Tooth neuropathy, hereditary motor and sensory neuropathy (HMSN), hereditary sensorimotor neuropathy (HSMN), or peroneal muscular atrophy, is an inherited disorder of nerves (neuropathy) that takes different forms. It is characterized by loss of muscle tissue and touch sensation, predominantly in the feet and legs but also in the hands and arms in the advanced stages of disease. Currently incurable, this disease is one of the most common inherited neurological disorders.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000023 "one of the most common inherited neurological disorders, affecting approximately 1 in 2,500 people in the United States.  CMT,  also known as hereditary motor and sensory neuropathy (HMSN) or peroneal muscular atrophy, comprises a group of disorders caused by mutations in genes that affect the normal function of the peripheral nerves.  The peripheral nerves lie outside the brain and spinal cord and supply the muscles and sensory organs in the limbs.  A typical feature includes weakness of the foot and lower leg muscles, which may result in foot drop and a high-stepped gait with frequent tripping or falls. Foot deformities, such as high arches and hammertoes (a condition in which the middle joint of a toe bends upwards), are also characteristic due to weakness of the small muscles in the feet.
")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000023 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000023 "http://en.wikipedia.org/wiki/Charcot%E2%80%93Marie%E2%80%93Tooth_disease")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000023 "http://www.ninds.nih.gov/disorders/charcot_marie_tooth/charcot_marie_tooth.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000023 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#nlx_dys_100316")
AnnotationAssertion(rdfs:label obo:ND_0000023 "Charcot-Marie tooth disease")
SubClassOf(obo:ND_0000023 obo:ND_0000003)

# Class: obo:ND_0000024 (demyelinating disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000024 "A neurological disease that is characterized by loss or dysfunction of myelin in the central or peripheral nervous system.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000024 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000024 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000024 "http://en.wikipedia.org/wiki/Demyelinating_disease")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000024 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12507")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000024 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi")
AnnotationAssertion(rdfs:label obo:ND_0000024 "demyelinating disease")
SubClassOf(obo:ND_0000024 obo:ND_0000001)
SubClassOf(obo:ND_0000024 ObjectSomeValuesFrom(obo:BFO_0000054 ObjectIntersectionOf(obo:ND_0006019 ObjectSomeValuesFrom(obo:BFO_0000118 obo:ND_0006001))))

# Class: obo:ND_0000025 (central pontine myelinolysis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000025 "Central pontine myelinolysis is neurological disease caused by severe damage of the myelin sheath of nerve cells in the brainstem, more precisely in the area termed the pons, predominately of iatrogenic etiology. It is characterized by acute paralysis, dysphagia (difficulty swallowing), and dysarthria (difficulty speaking), and other neurological symptoms.

It can also occur outside the pons. The term \"osmotic demyelination syndrome\" is similar to \"central pontine myelinolysis\", but also includes areas outside the pons.

Central pontine myelinolysis is a complication of treatment of patients with profound, life-threatening hyponatremia (low sodium). It occurs as a consequence of a rapid rise in serum tonicity following treatment in individuals with chronic, severe hyponatraemia who have made intracellular adaptations to the prevailing hypotonicity. Hyponatremia should be corrected at a rate of no more than 8-10 mmol/L of sodium per day to prevent central pontine myelinolysis.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000025 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000025 "http://en.wikipedia.org/wiki/Central_pontine_myelinolysis")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000025 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12552")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000025 "http://www.ncbi.nlm.nih.gov/mesh?term=central%20pontine%20myelinolysis%20")
AnnotationAssertion(rdfs:label obo:ND_0000025 "central pontine myelinolysis")
SubClassOf(obo:ND_0000025 obo:ND_0000024)

# Class: obo:ND_0000026 (autoimmune demyelinating disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000026 "A demyelinating autoimmune disease is a demyelinating disease that is caused by an autoimmune reaction.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000026 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000026 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000026 "demyelinating autoimmune disease")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000026 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12508")
AnnotationAssertion(rdfs:label obo:ND_0000026 "autoimmune demyelinating disease")
SubClassOf(obo:ND_0000026 obo:ND_0000024)
SubClassOf(obo:ND_0000026 ObjectSomeValuesFrom(obo:BFO_0000113 obo:ND_0005503))

# Class: obo:ND_0000027 (acute disseminated encephalomyelitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000027 "Acute disseminated encephalomyelitis (ADEM) is an immune mediated disease of the brain. It usually occurs following a viral infection but may appear following vaccination, bacterial or parasitic infection, or even appear spontaneously. As it involves autoimmune demyelination, it is similar to multiple sclerosis, and is considered part of the Multiple sclerosis borderline diseases. The incidence rate is about 8 per 1,000,000 people per year. Although it occurs in all ages, most reported cases are in children and adolescents, with the average age around 5 to 8 years old. The mortality rate may be as high as 5%, full recovery is seen in 50 to 75% of cases, while up to 70 to 90% recover with some minor residual disability. The average time to recover is one to six months.

ADEM produces multiple inflammatory lesions in the brain and spinal cord, particularly in the white matter. Usually these are found in the subcortical and central white matter and cortical gray-white junction of both cerebral hemispheres, cerebellum, brainstem, and spinal cord, but periventricular white matter and gray matter of the cortex, thalami and basal ganglia may also be involved.

When the patient suffers more than one demyelinating episode, it is called Recurrent disseminated encephalomyelitis or Multiphasic disseminated encephalomyelitis (MDEM).")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000027 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000027 "ADEM")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000027 "http://en.wikipedia.org/wiki/Acute_disseminated_encephalomyelitis")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000027 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12510")
AnnotationAssertion(rdfs:comment obo:ND_0000027 "Acute encephalomyelitis is a transient dymelinating disease course in which the patient has a single brief but intense attack of inflammation in the brain, or spinal cord, or optic nerve that causes damage to the myelin. MJ")
AnnotationAssertion(rdfs:comment obo:ND_0000027 "Unless all infectious diseases should be placed under the class 'autoimmune disease', this term and its children should probably be placed under the class 'demyelinating infectious disease' instead. AC")
AnnotationAssertion(rdfs:comment obo:ND_0000027 "leukodystrophy?

Yes, according to http://ulf.org/types-of-leukodystrophy

MJ")
AnnotationAssertion(rdfs:label obo:ND_0000027 "acute disseminated encephalomyelitis")
SubClassOf(obo:ND_0000027 obo:ND_0000026)

# Class: obo:ND_0000028 (post vaccinal encephalomyelitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000028 "Post vaccinal encephalomyelitis is acute disseminated encephalomyelitis that occurs after receiving a vaccination.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000028 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000028 "post-vaccinal encephalomyelitis")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000028 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12511")
AnnotationAssertion(rdfs:label obo:ND_0000028 "post vaccinal encephalomyelitis")
SubClassOf(obo:ND_0000028 obo:ND_0000027)

# Class: obo:ND_0000029 (post exanthem encephalomyelitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000029 "Post exanthem encephalomyelitis is acute disseminated encephalomyelitis that occurs after experiencing an exanthem infection.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000029 "Alexander P. Cox")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000029 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12512")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000029 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi?mode=&index=4480&field=all&HM=&II=&PA=&form=&input=")
AnnotationAssertion(rdfs:label obo:ND_0000029 "post exanthem encephalomyelitis")
SubClassOf(obo:ND_0000029 obo:ND_0000027)

# Class: obo:ND_0000030 (acute hemorrhagic leukoencephalitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000030 "Acute hemorrhagic leukoencephalitis (AHL, or AHLE), also known as acute necrotizing encephalopathy (ANE), acute hemorrhagic encephalomyelitis (AHEM), acute necrotizing hemorrhagic leukoencephalitis (ANHLE), Weston-Hurst syndrome, or Hurst's disease, is a hyperacute and frequently fatal form of ADEM. AHL is relatively rare (less than 100 cases have been reported in the medical literature as of 2006), it is seen in about 2% of ADEM cases, and is characterized by necrotizing vasculitis of venules and hemorrhage, and edema. Death is common in the first week and overall mortality is about 70%, but increasing evidence points to favorable outcomes after aggressive treatment with corticosteroids, immunoglobulins, cyclophosphamide, and plasma exchange. About 70% of survivors show residual neurological deficits, but some survivors have shown surprisingly little deficit considering the magnitude of the white matter affected. This disease has been occasionally associated with ulcerative colitis and Crohn's disease, septicemia associated with immune complex deposition, methanol poisoning, and other underlying conditions.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000030 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000030 "http://en.wikipedia.org/wiki/Acute_disseminated_encephalomyelitis#Acute_hemorrhagic_leukoencephalitis")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000030 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12513")
AnnotationAssertion(rdfs:label obo:ND_0000030 "acute hemorrhagic leukoencephalitis")
SubClassOf(obo:ND_0000030 obo:ND_0000026)

# Class: obo:ND_0000031 (diffuse cerebral sclerosis of Schilder)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000031 "Diffuse Cerebral Sclerosis of Schilder is a rare central nervous system demyelinating condition affecting children and young adults. Pathologic findings include a large, sharply defined, asymmetric focus of myelin destruction that may involve an entire lobe or cerebral hemisphere. The clinical course tends to be progressive and includes dementia, cortical blindness, cortical deafness, spastic hemiplegia, and pseudobulbar palsy. Concentric sclerosis of Balo is differentiated from diffuse cerebral sclerosis of Schilder by the pathologic finding of alternating bands of destruction and preservation of myelin in concentric rings. Alpers' Syndrome refers to a heterogeneous group of diseases that feature progressive cerebral deterioration and liver disease. (From Adams et al., Principles of Neurology, 6th ed, p914; Dev Neurosci 1991;13(4-5):267-73) ")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000031 "Alexander P. Cox")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000031 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12509")
AnnotationAssertion(rdfs:label obo:ND_0000031 "diffuse cerebral sclerosis of Schilder")
SubClassOf(obo:ND_0000031 obo:ND_0000026)

# Class: obo:ND_0000032 (primary progressive multiple sclerosis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000032 "The least common variant of multiple sclerosis, which is characterized by an immediate worsening in neurological functioning without intitial accute exacerbations and no return to homeostasis.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000032 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000032 "PPMS")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000032 "progressive relapsing multiple sclerosis")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000032 "TO DO")
AnnotationAssertion(obo:IAO_0000232 obo:ND_0000032 obo:IAO_0000123)
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000032 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12515")
AnnotationAssertion(rdfs:label obo:ND_0000032 "primary progressive multiple sclerosis")
SubClassOf(obo:ND_0000032 obo:ND_0000033)
SubClassOf(obo:ND_0000032 ObjectSomeValuesFrom(obo:BFO_0000054 obo:ND_0000202))

# Class: obo:ND_0000033 (multiple sclerosis)

AnnotationAssertion(obo:IAO_0000114 obo:ND_0000033 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000033 "An autoimmune demyelinating disease which is realized through marked episodes of neurological disability in the central nervous system, disseminated in both time and space following one of several predicable patterns of worsening.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000033 "Based on underlying pathology and genetic markers, there seem to be two to four subtypes: a replasing (most comon) varaint, an immediately progressive variant, and possibly the Marbiug and Devic variants. The common clinical variants of RRMS, SPMS, and PPMS are actually distinct disease courses, which realize the relapsing and progressive types of MS.")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000033 "Defintion needs revison once the material basis is sorted out. ")
AnnotationAssertion(obo:IAO_0000116 obo:ND_0000033 "Multiple sclerosis (MS) is a demylinating disease of the central nervous system in which the bearer's immune system causes demylination of neurons which must be disseminated in both time and space. MS can range from relatively benign to somewhat disabling to devastating, as communication between the brain and other parts of the body is disrupted.  Many investigators believe MS to be an autoimmune disease -- one in which the body, through its immune system, launches a defensive attack against its own tissues. In the case of MS, it is the nerve-insulating myelin that comes under assault. Such assaults may be linked to an unknown environmental trigger, perhaps a virus. 


")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000033 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000033 "MS")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000033 "http://www.ninds.nih.gov/disorders/multiple_sclerosis/multiple_sclerosis.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000033 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12514")
AnnotationAssertion(rdfs:label obo:ND_0000033 "multiple sclerosis")
SubClassOf(obo:ND_0000033 obo:ND_0000026)
SubClassOf(obo:ND_0000033 ObjectSomeValuesFrom(obo:BFO_0000054 obo:ND_0006009))

# Class: obo:ND_0000036 (relapsing multiple sclerosis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000036 "A type of multiple sclerosis which presents clinically with an overall relapsing profile of neurological worsening, measured according to a disability scale, such as the Kurtze Expanded Disability Status Scale (EDSS). The most common variant of multiple sclerosis, which is characterized by acute relapses with a return to either non-worsening or declining neurological functioning, known as remission. During the relapsing remitting phase, remission can be at the same level of clinical functioning as before the relapse, or at lower level, but homeostasis is achieved. Whereas, during the secondary progressive phase, a gradual deterioration in functioning occurs between relapses. Sometimes acute exacerbations may dissapear altogether. It is hypothesized the start of the secondary progressive phase correlates to a particular threshold of accumulating permanent damage to axons or the lack of ability to remyelinate.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000036 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000036 "RRMS")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000036 "SPMS")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000036 "relapsing remitting multiple sclerosis")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000036 "secondary progressive multiple sclerosis ")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000036 "TO DO")
AnnotationAssertion(obo:IAO_0000232 obo:ND_0000036 obo:IAO_0000123)
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000036 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12518
and
http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12517")
AnnotationAssertion(rdfs:label obo:ND_0000036 "relapsing multiple sclerosis")
SubClassOf(obo:ND_0000036 obo:ND_0000033)

# Class: obo:ND_0000037 (neuromyelitis optica)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000037 "Neuromyelitis optica (NMO), also known as Devic's disease or Devic's syndrome, is an autoimmune, inflammatory disorder in which a person's own immune system attacks the optic nerves and spinal cord. This produces an inflammation of the optic nerve (optic neuritis) and the spinal cord (myelitis). Although inflammation may also affect the brain, the lesions are different from those observed in the related condition multiple sclerosis (MS). Spinal cord lesions lead to varying degrees of weakness or paralysis in the legs or arms, loss of sensation (including blindness), and/or bladder and bowel dysfunction.

Devic's disease is a rare disorder which resembles MS in several ways, but requires a different course of treatment for optimal results. NMO has also been suggested to be a variant form of acute disseminated encephalomyelitis. The likely target of the autoimmune attack at least in some patients with NMO has been identified; it is a protein of the nervous system cells called aquaporin 4.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000037 "an uncommon disease syndrome of the central nervous system (CNS) that affects the optic nerves and spinal cord. Individuals with NMO develop optic neuritis, which causes pain in the eye and vision loss, and transverse myelitis, which causes weakness, numbness, and sometimes paralysis of the arms and legs, along with sensory disturbances and loss of bladder and bowel control. NMO leads to loss of myelin, which is a fatty substance that surrounds nerve fibers and helps nerve signals move from cell to cell. The syndrome can also damage nerve fibers and leave areas of broken-down tissue. In the disease process of NMO, for reasons that aren't yet clear, immune system cells and antibodies attack and destroy myelin cells in the optic nerves and the spinal cord. ")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000037 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000037 "Devic's Disease")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000037 "Devic's Syndrome")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000037 "NMO")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000037 "http://en.wikipedia.org/wiki/Neuromyelitis_optica")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000037 "http://www.ninds.nih.gov/disorders/neuromyelitis_optica/neuromyelitis_optica.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000037 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12519")
AnnotationAssertion(rdfs:comment obo:ND_0000037 "Neuromyelitis optica is an autoimmune, inflammatory disease in which an organism's immune system attacks the optic nerves and spinal cord, casuing inflammation of the optic nerve (optic neuritis) and the spinal cord (myelitis). Although inflammation may also affect the brain, the lesions are different from those observed in the related condition multiple sclerosis.")
AnnotationAssertion(rdfs:label obo:ND_0000037 "neuromyelitis optica")
SubClassOf(obo:ND_0000037 obo:ND_0000026)

# Class: obo:ND_0000038 (transverse myelitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000038 "Transverse myelitis is inflammation of the spinal cord, which often targets insulating material covering nerve cell fibers (myelin). Transverse myelitis may result in injury across the spinal cord, causing diminished or absent sensation below the injury.

The disrupted transmission of nerve signals due to transverse myelitis can cause pain or other sensory problems, weakness or paralysis of muscles, or bladder and bowel dysfunction.

Several factors can cause transverse myelitis, including infections not directly affecting the spine and immune system disorders attacking the body's own tissues. It may also occur as an episode of other myelin disorders, such as multiple sclerosis.

Treatment for transverse myelitis includes anti-inflammatory drugs, medications to manage symptoms and rehabilitative therapy. Most people with transverse myelitis experience at least partial recovery.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000038 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000038 "http://www.mayoclinic.com/health/transverse-myelitis/DS00854")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000038 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12520")
AnnotationAssertion(rdfs:label obo:ND_0000038 "transverse myelitis")
SubClassOf(obo:ND_0000038 obo:ND_0000026)

# Class: obo:ND_0000039 (paraneoplastic myelitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000039 "Paraneoplastic myelitis is an inflammation of the spinal cord. Any level of the spinal cord can be affected, from the cervical region (upper part of the cord) to the lumbar region (lower part). The inflammation causes problems in how the nerves function that carry information back and forth between the nerves in your arms and legs and the brain.

Patients may develop:
    loss of strength and sensation
    abnormal reflexes
    muscle twitches or sometimes jerking muscles
    thinning or decrease of muscle volume (atrophy) in the arms, legs and other parts of the body (neck, back) (Figure)
    control of the bladder and bowel movements can be affected

Paraneoplastic myelitis usually occurs in association with encephalitis.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000039 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000039 "http://www.penncancer.org/pnd/subpage.cfm?s=1&ss=22&sss=12")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000039 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12523")
AnnotationAssertion(rdfs:label obo:ND_0000039 "paraneoplastic myelitis")
SubClassOf(obo:ND_0000039 obo:ND_0000038)

# Class: obo:ND_0000040 (post infectious myelitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000040 "Inflammation of a transverse portion of the spinal cord characterized by acute or subacute segmental demyelination or necrosis. The condition may occur sporadically, follow an infection or vaccination, or present as a paraneoplastic syndrome (see also ENCEPHALOMYELITIS, ACUTE DISSEMINATED). Clinical manifestations include motor weakness, sensory loss, and incontinence. (Adams et al., Principles of Neurology, 6th ed, pp1242-6)
")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000040 "Post infectious myelitis is transverse myelitis that occurs as the result of an infection.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000040 "Alexander P. Cox")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000040 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12521")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000040 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi?mode=&index=8798&field=all&HM=&II=&PA=&form=&input=")
AnnotationAssertion(rdfs:label obo:ND_0000040 "post infectious myelitis")
SubClassOf(obo:ND_0000040 obo:ND_0000038)

# Class: obo:ND_0000041 (post vaccinal myelitis)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000041 "Inflammation of a transverse portion of the spinal cord characterized by acute or subacute segmental demyelination or necrosis. The condition may occur sporadically, follow an infection or vaccination, or present as a paraneoplastic syndrome (see also ENCEPHALOMYELITIS, ACUTE DISSEMINATED). Clinical manifestations include motor weakness, sensory loss, and incontinence. (Adams et al., Principles of Neurology, 6th ed, pp1242-6)")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000041 "Post vaccinal myelitis is transverse myelitis that occurs in response to a vaccination.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000041 "Alexander P. Cox")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000041 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12522")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000041 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi?mode=&index=8798&field=all&HM=&II=&PA=&form=&input=")
AnnotationAssertion(rdfs:comment obo:ND_0000041 "Why is 'post vaccinal myelitis' a subclass of 'post infectious myelitis'?")
AnnotationAssertion(rdfs:label obo:ND_0000041 "post vaccinal myelitis")
SubClassOf(obo:ND_0000041 obo:ND_0000040)

# Class: obo:ND_0000042 (hereditary central nervous system demyelinating disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000042 "A Hereditary CNS demyelinating disease is a demyelinating central nervous system disease that is primarily due to an inherited genetic condition. (This is in contrast to autoimmune demyelinating conditions, such as multiple sclerosis, or conditions such as central pontine myelinolysis that are associated with acute acquired insult.)

Examples include:
    Alexander disease
    Canavan disease
    Krabbe disease
    leukoencephalopathy with vanishing white matter
    megalencephalic leukoencephalopathy with subcortical cysts
    metachromatic leukodystrophy
    X-linked adrenoleukodystrophy")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000042 "Inherited conditions characterized by a loss of MYELIN in the central nervous system.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000042 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000042 "Mark Jensen")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000042 "http://en.wikipedia.org/wiki/Hereditary_CNS_demyelinating_disease")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000042 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12526")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000042 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi?mode=&index=18793&field=all&HM=&II=&PA=&form=&input=
")
AnnotationAssertion(rdfs:comment obo:ND_0000042 "Recommnend deleting. The fact a disease (any disease, genetic or otherwise) is a CNS disease should be inferred. This is according to the hierarchical structure for diseases ND supports.

MJ")
AnnotationAssertion(rdfs:comment obo:ND_0000042 "See the comment for 'demyelinating autoimmune disease'.  Perhaps this class should be labeled (or at least subsumed under) 'demyelinating genetic disease' instead.

Also, add 'leukoencephalopathy with vanishing white matter' and 'megalencephalic leukoencephalopathy with subcortical cysts' as subclasses of 'hereditary central nervous system demyelinating disease'.")
AnnotationAssertion(rdfs:label obo:ND_0000042 "hereditary central nervous system demyelinating disease")
SubClassOf(obo:ND_0000042 obo:ND_0000156)

# Class: obo:ND_0000043 (adrenoleukodystrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000043 "Adrenoleukodystrophy (ALD, also called Siemerling-Creutzfeldt Disease or Schilder's disease) is a rare, inherited disorder that leads to progressive brain damage, failure of the adrenal glands and eventually death. ALD is a disease in a group of genetic disorders called leukodystrophies. Adrenoleukodystrophy progressively damages the myelin sheath, a complex fatty neural tissue that insulates many nerves of the central and peripheral nervous systems. Without functional myelin, nerves are unable to aid in the conduction of an impulse, which leads to increasing disability.

There are several different types of the disease which can be inherited, but the most common form is an X-linked condition. X-linked ALD primarily affects males, but about one in five women with the disease gene develop some symptoms. Adrenomyeloneuropathy is a less-severe form of ALD, with onset of symptoms occurring in adolescence or adulthood. This form does not include cerebral involvement, and should be included in the differential diagnosis of all males with adrenal insufficiency. Although they share a similar name, X-linked ALD and neonatal adrenoleukodystrophy (NALD), a peroxisome biogenesis disorder, are completely different diseases.

Patients with X-linked ALD have defects in the ATP-binding cassette, sub-family D (ALD), member 1 transporter protein, which is encoded by the ABCD1 gene. The ABCD1 (aka ALDP) protein is indirectly involved in the breakdown of very long-chain fatty acids (VLCFAs) found in the normal diet. Lack of this protein can give rise to an over-accumulation of VLCFAs which can lead to damage to the brain, adrenal gland, and peripheral nervous system.

Although this disorder affects the growth and/or development of myelin, leukodystrophies are different from demyelinating disorders such as multiple sclerosis where myelin is formed normally but is lost by immunologic dysfunction or for other reasons.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000043 "one of a group of genetic disorders called the leukodystrophies that cause damage to the myelin sheath, an insulating membrane that surrounds nerve cells in the brain. People with ALD accumulate high levels of saturated, very long chain fatty acids (VLCFA) in the brain and adrenal cortex because they do not produce the enzyme that breaks down these fatty acids in the normal manner. The loss of myelin and the progressive dysfunction of the adrenal gland are the primary characteristics of ALD. ALD has two subtypes. The most common is the X-linked form (X-ALD), which involves an abnormal gene located on the X-chromosome. Women have two X-chromosomes and are the carriers of the disease, but since men only have one X-chromosome and lack the protective effect of the extra X-chromosome, they are more severely affected. Onset of X-ALD can occur in childhood or in adulthood. The childhood form is the most severe, with onset between ages 4 and 10. The most common symptoms are usually behavioral changes such as abnormal withdrawal or aggression, poor memory, and poor school performance. Other symptoms include visual loss, learning disabilities, seizures, poorly articulated speech, difficulty swallowing, deafness, disturbances of gait and coordination, fatigue, intermittent vomiting, increased skin pigmentation, and progressive dementia. In the milder adult-onset form, which typically begins between ages 21 and 35, symptoms may include progressive stiffness, weakness or paralysis of the lower limbs, and ataxia. Although adult-onset ALD progresses more slowly than the classic childhood form, it can also result in deterioration of brain function. A mild form of ALD is occasionally seen in women who are carriers of the disorder.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000043 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000043 "ALD")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000043 "Schilder's disease")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000043 "Siemerling-Creutzfeldt disease")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000043 "X-linked ALD")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000043 "X-linked adrenoleukodystrophy")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000043 "http://en.wikipedia.org/wiki/X-linked_adrenoleukodystrophy")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000043 "http://www.ninds.nih.gov/disorders/adrenoleukodystrophy/adrenoleukodystrophy.htm
")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000043 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12527")
AnnotationAssertion(rdfs:label obo:ND_0000043 "adrenoleukodystrophy")
SubClassOf(obo:ND_0000043 obo:ND_0002022)

# Class: obo:ND_0000044 (Alexander disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000044 "Alexander disease is a slowly progressing and fatal neurodegenerative disease. It is a very rare disorder which results from a genetic mutation and mostly affects infants and children, causing developmental delay and changes in physical characteristics.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000044 "one of a group of neurological conditions known as the leukodystrophies, disorders that are the result of abnormalities in myelin, the “white matter” that protects nerve fibers in the brain. Alexander disease is a progressive and usually fatal disease.  The destruction of white matter is accompanied by the formation of Rosenthal fibers, which are abnormal clumps of protein that accumulate in non-neuronal cells of the brain called astrocytes.  Rosenthal fibers are sometimes found in other disorders, but not in the same amount or area of the brain that are featured in Alexander disease.  The infantile form is the most common type of Alexander disease.  It has an onset during the first two years of life.  Usually there are both mental and physical developmental delays, followed by the loss of developmental milestones, an abnormal increase in head size, and seizures. The juvenile form of Alexander disease is less common and has an onset between the ages of two and thirteen.  These children may have excessive vomiting, difficulty swallowing and speaking, poor coordination, and loss of motor control.  Adult-onset forms of Alexander disease are rare, but have been reported.  The symptoms sometimes mimic those of Parkinson’s disease or multiple sclerosis.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000044 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000044 "http://en.wikipedia.org/wiki/Alexander_disease")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000044 "http://www.ninds.nih.gov/disorders/alexander_disease/alexander_disease.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000044 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12528")
AnnotationAssertion(rdfs:label obo:ND_0000044 "Alexander disease")
SubClassOf(obo:ND_0000044 obo:ND_0002022)

# Class: obo:ND_0000045 (Canavan disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000045 "Canavan disease, also called Canavan-Van Bogaert-Bertrand disease, aspartoacylase deficiency or aminoacylase 2 deficiency, is an autosomal recessive degenerative disorder that causes progressive damage to nerve cells in the brain. Canavan disease is also one of the most common degenerative cerebreal diseases of infancy. This disease is one of a group of genetic disorders called leukodystrophies.

Leukodystrophies are characterized by degeneration of myelin in the phospholipid layer insulating the axon of a neuron. The gene associated with the disorder is located on human chromosome 17.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000045 "one of the most common cerebral degenerative diseases of infancy, is a gene-linked, neurological birth disorder in which the brain degenerates into spongy tissue riddled with microscopic fluid-filled spaces. Canavan disease has been classified as one of a group of genetic disorders known as the leukodystrophies but--unlike most leukodystrophies--both grey and white matter are severely affected in infants with Canavan disease. Recent research has indicated that the cells in the brain responsible for making myelin sheaths, known as oligodendrocytes, cannot proroperly complete this critical developmental task.  Myelin sheaths are the fatty covering that act as insulators around nerve fibers in the brain, as well as providing nutritional support for nerve cells.  In Canavan disease, many oligodendrocytes do not mature  and instead die, leaving nerve cell projections known as axons vulnerable and unable to properly function.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000045 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000045 "http://en.wikipedia.org/wiki/Canavan_disease")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000045 "http://www.ninds.nih.gov/disorders/canavan/canavan.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000045 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12529")
AnnotationAssertion(rdfs:label obo:ND_0000045 "Canavan disease")
SubClassOf(obo:ND_0000045 obo:ND_0002022)

# Class: obo:ND_0000046 (type I Canavan disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000046 "Neonatal Form Onset is at birth and death occurs within few weeks of life.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000046 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000046 "http://www.mazornet.com/genetics/canavan.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000046 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12530")
AnnotationAssertion(rdfs:label obo:ND_0000046 "type I Canavan disease")
SubClassOf(obo:ND_0000046 obo:ND_0000045)

# Class: obo:ND_0000047 (type II Canavan disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000047 "Infantile Form Onset is at a few months of life and death occurs between ages three and four. This is the most common type of Canavan.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000047 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000047 "http://www.mazornet.com/genetics/canavan.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000047 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12531")
AnnotationAssertion(rdfs:label obo:ND_0000047 "type II Canavan disease")
SubClassOf(obo:ND_0000047 obo:ND_0000045)

# Class: obo:ND_0000048 (type III Canavan disease)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000048 " Juvenile Form Onset after age five and death occurs at adolescence")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000048 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000048 "http://www.mazornet.com/genetics/canavan.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000048 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12532")
AnnotationAssertion(rdfs:label obo:ND_0000048 "type III Canavan disease")
SubClassOf(obo:ND_0000048 obo:ND_0000045)

# Class: obo:ND_0000049 (globoid cell leukodystrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000049 "Krabbe disease (also known as globoid cell leukodystrophy or galactosylceramide lipidosis) is a rare, often fatal degenerative disorder that affects the myelin sheath of the nervous system. This condition is inherited in an autosomal recessive pattern. The disease is named for the Danish neurologist Knud Haraldsen Krabbe.")
AnnotationAssertion(obo:IAO_0000115 obo:ND_0000049 "a rare, inherited degenerative disorder of the central and peripheral nervous systems.  It is characterized by the presence of globoid cells (cells that have more than one nucleus), the breakdown of the nerve’s protective myelin coating, and destruction of brain cells.  Krabbe disease is one of a group of genetic disorders called the leukodystrophies.  These disorders impair the growth or development of the myelin sheath, the fatty covering that acts as an insulator around nerve fibers, and cause severe deterioration of mental and motor skills.  Myelin, which lends its color to the “white matter” of the brain, is a complex substance made up of at least 10 different enzymes.  Each of the leukodystrophies affects one (and only one) of these substances.  Krabbe disease is caused by a deficiency ofgalactocerebrosidase, an essential enzyme for myelin metabolism.  The disease most often affects infants, with onset before age 6 months, but can occur in adolescence or adulthood.  Symptoms include irritability, unexplained fever, limb stiffness, seizures, feeding difficulties, vomiting, and slowing of mental and motor development.  Other symptoms include muscle weakness, spasticity, deafness, and blindness.  An autosomal recessive metabolic disorder caused by a deficiency of GALACTOSYLCERAMIDASE leading to intralysosomal accumulation of galactolipids such as GALACTOSYLCERAMIDES and PSYCHOSINE. It is characterized by demyelination associated with large multinucleated globoid cells, predominantly involving the white matter of the central nervous system. The loss of MYELIN disrupts normal conduction of nerve impulses (MeSH).
")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000049 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000049 "Krabbe disease")
AnnotationAssertion(obo:IAO_0000118 obo:ND_0000049 "galactosylceramide lipidosis")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000049 "http://en.wikipedia.org/wiki/Krabbe_disease")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000049 "http://www.ninds.nih.gov/disorders/krabbe/krabbe.htm")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000049 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12533")
AnnotationAssertion(rdfs:label obo:ND_0000049 "globoid cell leukodystrophy")
SubClassOf(obo:ND_0000049 obo:ND_0002022)

# Class: obo:ND_0000050 (classic globoid cell leukodystrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000050 "An autosomal recessive metabolic disorder caused by a deficiency of GALACTOSYLCERAMIDASE leading to intralysosomal accumulation of galactolipids such as GALACTOSYLCERAMIDES andPSYCHOSINE. It is characterized by demyelination associated with large multinucleated globoid cells, predominantly involving the white matter of the central nervous system. The loss of MYELIN disrupts normal conduction of nerve impulses.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000050 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000050 "http://www.nlm.nih.gov/cgi/mesh/2011/MB_cgi")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000050 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12534")
AnnotationAssertion(rdfs:label obo:ND_0000050 "classic globoid cell leukodystrophy")
SubClassOf(obo:ND_0000050 obo:ND_0000049)

# Class: obo:ND_0000051 (early onset globoid cell leukodystrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000051 "Symptoms of early-onset GLD usually appear in babies between 2 and 12 months of age.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000051 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000051 "http://marrow.org/Patient/Disease_and_Treatment/About_Your_Disease/Metabolic_Disorders/Krabbe_Disease.aspx")
