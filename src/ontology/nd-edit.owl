# Class: obo:ND_0000125 (type I spinal muscular atrophy)

AnnotationAssertion(obo:IAO_0000115 obo:ND_0000125 "A severe type of spinal muscular atrophy, with on set of symptoms generally in infancy. Children with Type I SMA never sit.")
AnnotationAssertion(obo:IAO_0000117 obo:ND_0000125 "Alexander P. Cox")
AnnotationAssertion(obo:IAO_0000119 obo:ND_0000125 "http://neurolex.org/wiki/Category:Type_I_Spinal_Muscular_Atrophy")
AnnotationAssertion(oboInOwl:hasDbXref obo:ND_0000125 "http://ontology.neuinfo.org/NIF/Dysfunction/NIF-Dysfunction.owl#birnlex_12570")
AnnotationAssertion(rdfs:label obo:ND_0000125 "type I spinal muscular atrophy")
